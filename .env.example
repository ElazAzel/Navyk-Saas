# Public URLs exposed to the browser
NEXT_PUBLIC_SITE_URL=https://your-production-domain.com
# TODO: replace with a secure random secret before going live
NEXT_PUBLIC_JWT_SECRET=replace_me_with_secure_value

# Server configuration for socket server and services
CLIENT_URL=http://localhost:3000
# Secret used on the server for signing/verifying JWT tokens
JWT_SECRET=replace_me_with_secure_value
# URL of the machine learning service used for analytics
ML_SERVICE_URL=http://localhost:8000
# Port for the socket server
PORT=3001
